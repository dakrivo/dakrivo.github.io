---
import BaseLayout from '../layouts/BaseLayout.astro';
import { bio, skills } from '../data/content';
---

<BaseLayout
	title="Deen Akrivos"
	description="MASc researcher in Mechanical Engineering — CFD, machine learning, and turbulence modelling."
	current="home"
>
	<section class="container hero">
		<div class="masthead">
			<img src="/assets/profile.jpg" alt="Deen Akrivos" class="avatar" />
			<div>
				<h1>Deen Akrivos</h1>
				<p class="headline accent">
					<span data-i18n="en">{bio.headline.en}</span>
					<span data-i18n="fr">{bio.headline.fr}</span>
				</p>
			</div>
		</div>

		<div class="bio">
			{bio.paragraphs.map((p) => (
				<p>
					<span data-i18n="en">{p.en}</span>
					<span data-i18n="fr">{p.fr}</span>
				</p>
			))}
			<div class="cta-row">
				<a class="btn" href="/projects/">
					<span data-i18n="en">See my research & projects</span>
					<span data-i18n="fr">Voir mes recherches et projets</span>
				</a>
				<a class="btn ghost" href="/contact/">
					<span data-i18n="en">Get in touch</span>
					<span data-i18n="fr">Me contacter</span>
				</a>
			</div>
		</div>
	</section>

	<section class="container">
		<h2>
			<span data-i18n="en">Toolkit</span>
			<span data-i18n="fr">Outils</span>
		</h2>
		<div class="panel skill-groups">
			<div>
				<h4 class="muted">
					<span data-i18n="en">CFD & Engineering</span>
					<span data-i18n="fr">CFD et ingénierie</span>
				</h4>
				<p class="mono">{skills.tools.join(' · ')}</p>
			</div>
			<div>
				<h4 class="muted">
					<span data-i18n="en">Programming</span>
					<span data-i18n="fr">Programmation</span>
				</h4>
				<p class="mono">{skills.languages.join(' · ')}</p>
			</div>
			<div>
				<h4 class="muted">HPC / ML</h4>
				<p class="mono">{skills.hpcMl.join(' · ')}</p>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.hero {
		padding-top: var(--space-6);
		padding-bottom: var(--space-6);
	}

	.masthead {
		display: flex;
		align-items: center;
		gap: var(--space-4);
		margin-bottom: var(--space-5);
	}

	.avatar {
		width: 96px;
		height: 96px;
		border-radius: 50%;
		object-fit: cover;
		border: 2px solid var(--color-hairline);
		flex-shrink: 0;
	}

	h1 {
		margin: 0;
		font-size: 2.2rem;
		letter-spacing: -0.01em;
	}

	.headline {
		font-size: 1.05rem;
		margin: var(--space-1) 0 0;
	}

	.bio {
		max-width: 700px;
	}

	.bio p {
		font-size: 1.02rem;
	}

	.cta-row {
		display: flex;
		gap: var(--space-3);
		margin-top: var(--space-4);
		flex-wrap: wrap;
	}

	.btn {
		display: inline-block;
		text-decoration: none;
		background: var(--color-accent);
		color: var(--color-bg);
		font-weight: 600;
		padding: var(--space-2) var(--space-4);
		border-radius: var(--radius);
		transition: transform 0.15s ease, box-shadow 0.15s ease;
	}

	.btn:hover {
		transform: translateY(-1px);
		box-shadow: 0 6px 20px -6px var(--color-accent-soft);
	}

	.btn.ghost {
		background: transparent;
		color: var(--color-white);
		border: 1px solid var(--color-hairline);
	}

	.btn.ghost:hover {
		border-color: var(--color-accent);
	}

	.panel {
		background: var(--color-surface);
		border: 1px solid var(--color-hairline);
		border-radius: var(--radius);
		padding: var(--space-4);
	}

	.skill-groups {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		gap: var(--space-4);
		margin-top: var(--space-3);
	}

	.skill-groups h4 {
		margin: 0 0 var(--space-1);
		font-size: 0.85rem;
		text-transform: uppercase;
		letter-spacing: 0.04em;
	}

	.skill-groups p {
		margin: 0;
		font-size: 0.9rem;
	}

	@media (max-width: 640px) {
		.masthead {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>
