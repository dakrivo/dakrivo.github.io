---
const { current } = Astro.props as { current: string };

const links = [
	{ href: '/', key: 'home', en: 'Home', fr: 'Accueil' },
	{ href: '/projects/', key: 'projects', en: 'Projects', fr: 'Projets' },
	{ href: '/work/', key: 'work', en: 'Work', fr: 'Expérience' },
	{ href: '/blog/', key: 'blog', en: 'Blog', fr: 'Blogue' },
	{ href: '/contact/', key: 'contact', en: 'Contact', fr: 'Contact' },
];
---

<header class="nav">
	<div class="container nav-inner">
		<a class="brand mono" href="/">deen akrivos</a>
		<nav class="links">
			{links.map((link) => (
				<a href={link.href} class={current === link.key ? 'active' : ''}>
					<span data-i18n="en">{link.en}</span>
					<span data-i18n="fr">{link.fr}</span>
				</a>
			))}
		</nav>
		<button id="lang-toggle" class="lang-toggle mono" aria-label="Toggle language" type="button">
			<span data-i18n="en">FR</span>
			<span data-i18n="fr">EN</span>
		</button>
	</div>
</header>

<style>
	.nav {
		border-bottom: 1px solid var(--color-hairline);
		background: color-mix(in srgb, var(--color-bg) 92%, transparent);
		backdrop-filter: blur(8px);
		position: sticky;
		top: 0;
		z-index: 10;
	}

	.nav-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-4);
		padding-top: var(--space-3);
		padding-bottom: var(--space-3);
	}

	.brand {
		font-weight: 600;
		font-size: 1.05rem;
		letter-spacing: 0.02em;
		text-decoration: none;
		color: var(--color-white);
	}

	.links {
		display: flex;
		gap: var(--space-4);
		flex-wrap: wrap;
	}

	.links a {
		text-decoration: none;
		color: var(--color-muted);
		font-size: 0.95rem;
		transition: color 0.15s ease;
	}

	.links a:hover,
	.links a.active {
		color: var(--color-white);
	}

	.lang-toggle {
		background: transparent;
		border: 1px solid var(--color-hairline);
		color: var(--color-muted);
		border-radius: var(--radius);
		padding: var(--space-1) var(--space-3);
		cursor: pointer;
		font-size: 0.8rem;
	}

	.lang-toggle:hover {
		border-color: var(--color-accent);
		color: var(--color-accent);
	}

	@media (max-width: 640px) {
		.nav-inner {
			flex-wrap: wrap;
		}
		.links {
			order: 3;
			width: 100%;
			gap: var(--space-3);
		}
	}
</style>

<script>
	function currentLang(): 'en' | 'fr' {
		return document.documentElement.getAttribute('data-lang') === 'fr' ? 'fr' : 'en';
	}

	function applyLang(lang: 'en' | 'fr') {
		document.documentElement.setAttribute('data-lang', lang);
		localStorage.setItem('lang', lang);
	}

	document.getElementById('lang-toggle')?.addEventListener('click', () => {
		applyLang(currentLang() === 'en' ? 'fr' : 'en');
	});
</script>
